# Общие настройки Docker Compose; укажи новый надёжный пароль.
POSTGRES_DB=podzemelye
POSTGRES_USER=podzemelye
POSTGRES_PASSWORD=
MAX_BOT_TOKEN=
MAX_SUPER_ADMIN_ID=
MAX_CA_FILE=certificates/russian_trusted_root_ca.pem
SCHEDULE_NOTIFICATIONS_ENABLED=0
HOMEWORK_NOTIFICATIONS_ENABLED=0
EVENT_NOTIFICATIONS_ENABLED=0
DB_POOL_MAX_SIZE=0
# Только для запуска Python вне контейнера: тот же пароль, URL-encoded.
DATABASE_URL=postgresql://podzemelye:REPLACE_ME@127.0.0.1:5432/podzemelye
